{
  "name": "sticky",
  "version": "1.0.0",
  "description": "Tactile, freeform sticky note canvas with collectible rarity tiers, physics, and custom disappearance effects.",
  "license": "MIT",
  "author": "Nicat Bayramov",
  "keywords": [
    "sticky-notes",
    "canvas",
    "physics",
    "rarity",
    "bun",
    "typescript",
    "tailwindcss"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BayramovNicat/bunvite.git"
  },
  "homepage": "https://github.com/BayramovNicat/bunvite#readme",
  "scripts": {
    "dev": "bun --watch run vite.ts dev",
    "build": "bun run vite.ts build",
    "preview": "bun run vite.ts preview",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check .",
    "format": "bunx biome check --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "graphify": "graphify update .",
    "graphify:watch": "graphify watch .",
    "graphify:query": "graphify query",
    "graphify:affected": "graphify affected",
    "graphify:hubs": "graphify god-nodes"
  },
  "type": "module",
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "jsx-dom": "^8.1.6"
  }
}
